NODE_ENV=development
PORT=4000

# Supabase PostgreSQL runtime URL from Dashboard > Connect.
# Use Supavisor transaction mode (port 6543) with pgbouncer=true, connection_limit=1, and sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Supabase PostgreSQL admin URL from Dashboard > Connect.
# Prefer the Supavisor session URL (port 5432) on IPv4-only networks; use for Prisma CLI operations only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
JWT_REFRESH_EXPIRES_IN_DAYS=30
GEMINI_API_KEY=""
GEMINI_MODEL="configured-model-name"
# Comma-separated exact browser origins. Production must list only trusted deployed origins.
FRONTEND_URLS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
