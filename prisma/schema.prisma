generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  OCR_PROCESSING
  ANALYZING
  READY
  FAILED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum KnowledgeEntityType {
  PERSON
  ORGANIZATION
  PROJECT
  TASK
  DATE
  TECHNOLOGY
  TOPIC
  LOCATION
  DOCUMENT
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  name            String
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     Membership[]
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]       @relation("AuditActor")
}

model Workspace {
  id                 String                  @id @default(uuid()) @db.Uuid
  name               String
  slug               String                  @unique
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  memberships        Membership[]
  sessions           RefreshSession[]
  documents          Document[]
  tasks              Task[]
  conversations      Conversation[]
  notifications      Notification[]
  usageEvents        UsageEvent[]
  auditLogs          AuditLog[]
  knowledgeEntities  KnowledgeEntity[]
  knowledgeSources   KnowledgeEntitySource[]
  knowledgeRelations KnowledgeRelation[]
}

model Membership {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  workspaceId String         @db.Uuid
  role        MembershipRole @default(MEMBER)
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model RefreshSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  workspaceId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([workspaceId, createdAt])
}

model Document {
  id                 String                  @id @default(uuid()) @db.Uuid
  workspaceId        String                  @db.Uuid
  uploadedById       String                  @db.Uuid
  name               String
  mimeType           String
  sizeBytes          Int
  storageKey         String
  status             DocumentStatus          @default(UPLOADED)
  extractedText      String?
  summary            String?
  keyPoints          Json?
  keywords           Json?
  actionItems        Json?
  importantDates     Json?
  errorCode          String?
  errorMessage       String?
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks             DocumentChunk[]
  tasks              Task[]
  knowledgeSources   KnowledgeEntitySource[]
  knowledgeRelations KnowledgeRelation[]

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model DocumentChunk {
  id               String                  @id @default(uuid()) @db.Uuid
  workspaceId      String                  @db.Uuid
  documentId       String                  @db.Uuid
  chunkIndex       Int
  pageNumber       Int?
  content          String
  createdAt        DateTime                @default(now())
  document         Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeSources KnowledgeEntitySource[]

  @@unique([documentId, chunkIndex])
  @@index([workspaceId, documentId])
}

model KnowledgeEntity {
  id                String                  @id @default(uuid()) @db.Uuid
  workspaceId       String                  @db.Uuid
  name              String
  normalized        String
  type              KnowledgeEntityType
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sources           KnowledgeEntitySource[]
  outgoingRelations KnowledgeRelation[]     @relation("KnowledgeRelationSource")
  incomingRelations KnowledgeRelation[]     @relation("KnowledgeRelationTarget")

  @@unique([workspaceId, normalized, type])
  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([workspaceId, normalized])
}

model KnowledgeEntitySource {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  entityId    String          @db.Uuid
  documentId  String          @db.Uuid
  chunkId     String?         @db.Uuid
  excerpt     String?
  pageNumber  Int?
  createdAt   DateTime        @default(now())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entity      KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk       DocumentChunk?  @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@unique([entityId, documentId, chunkId])
  @@index([workspaceId, documentId])
  @@index([workspaceId, entityId])
}

model KnowledgeRelation {
  id             String          @id @default(uuid()) @db.Uuid
  workspaceId    String          @db.Uuid
  sourceEntityId String          @db.Uuid
  targetEntityId String          @db.Uuid
  type           String
  confidence     Float           @default(1)
  documentId     String?         @db.Uuid
  excerpt        String?
  createdAt      DateTime        @default(now())
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceEntity   KnowledgeEntity @relation("KnowledgeRelationSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity   KnowledgeEntity @relation("KnowledgeRelationTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)
  document       Document?       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceEntityId, targetEntityId, type, documentId])
  @@index([workspaceId, sourceEntityId])
  @@index([workspaceId, targetEntityId])
  @@index([workspaceId, type])
}

model Task {
  id               String       @id @default(uuid()) @db.Uuid
  workspaceId      String       @db.Uuid
  createdById      String       @db.Uuid
  sourceDocumentId String?      @db.Uuid
  title            String
  description      String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  dueDate          DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceDocument   Document?    @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
}

model Conversation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  title       String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([workspaceId, updatedAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  title       String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model UsageEvent {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  eventType   String
  quantity    Int       @default(1)
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  actorUserId String?   @db.Uuid
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}
